<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Fae-Child</name>
		<description>Fae-Child background — broad/anywhere, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-fae-child.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-fae-child.xml" />
		</update>
	</info>
	<element name="Fae-Child" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_FAE_CHILD">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Dexterity, Wisdom, Charisma</li>
				<li><strong>Feat:</strong> Fae-Marked</li>
				<li><strong>Skill Proficiencies:</strong> Perception and Survival</li>
				<li><strong>Tool Proficiency:</strong> <i>Choose one kind of Tool</i></li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Traveler's Clothes, Bedroll, Rations (5 days), Trinket, 20 GP; or (B) 50 GP</li>
			</ul>
			<p>You wandered too far into the woods as a child and didn't come back the same. Time spent lost — or taken — in the Fae wild left its mark, and something about you has never quite fit back into the world you left.</p>
		</description>
		<setters>
			<set name="short">Dexterity, Wisdom, Charisma, Fae-Marked Feat, Perception and Survival Skills, a Tool of your choice</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_DEX_WIS_CHA" />
			<grant type="Feat" id="ID_ATERIOR_FEAT_FAE_MARKED" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_PERCEPTION" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_SURVIVAL" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<select type="Proficiency" name="Tool Proficiency (Fae-Child)" supports="Tool" />
		</rules>
	</element>
</elements>
