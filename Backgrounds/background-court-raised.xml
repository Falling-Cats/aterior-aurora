<elements>
	<info>
		<name>Court-Raised</name>
		<description>Court-Raised background — broad/anywhere, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-court-raised.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-court-raised.xml" />
		</update>
