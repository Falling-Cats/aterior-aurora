<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Recordkeeper</name>
		<description>Recordkeeper background — Dagon, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-recordkeeper.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-recordkeeper.xml" />
		</update>
	</info>
	<element name="Recordkeeper" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_RECORDKEEPER">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Intelligence, Wisdom, Charisma</li>
				<li><strong>Feat:</strong> Historian</li>
				<li><strong>Skill Proficiencies:</strong> History and Insight</li>
				<li><strong>Tool Proficiency:</strong> Calligrapher's Supplies</li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Book (records), Ink and Ink Pen, Parchment (10 sheets), Case (scroll), Traveler's Clothes, 20 GP; or (B) 50 GP</li>
			</ul>
			<p>Your childhood revolved around maintaining, studying, or verifying Dagon's records of battles, victories, and losses. You learned that in Dagon, history can determine someone's rank.</p>
		</description>
		<setters>
			<set name="short">Intelligence, Wisdom, Charisma, Historian Feat, History and Insight Skills, Calligrapher's Supplies</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_INT_WIS_CHA" />
			<grant type="Feat" id="ID_ATERIOR_FEAT_HISTORIAN" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_HISTORY" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_INSIGHT" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<grant type="Proficiency" id="ID_PROFICIENCY_TOOL_PROFICIENCY_CALLIGRAPHERS_SUPPLIES" />
		</rules>
	</element>
</elements>
