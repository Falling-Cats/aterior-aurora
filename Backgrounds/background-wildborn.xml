<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Wildborn</name>
		<description>Wildborn background — broad/anywhere, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-wildborn.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-wildborn.xml" />
		</update>
	</info>
	<element name="Wildborn" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_WILDBORN">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Strength, Dexterity, Wisdom</li>
				<li><strong>Feat:</strong> Alert</li>
				<li><strong>Skill Proficiencies:</strong> Survival and Animal Handling</li>
				<li><strong>Tool Proficiency:</strong> Herbalism Kit</li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Traveler's Clothes, Bedroll, Waterskin, Rope (50 ft), Rations (5 days), 10 GP; or (B) 50 GP</li>
			</ul>
			<p>You were raised in the wilderness, not in a town or village. The forest — or the plains, or the mountains — was home long before any settlement was.</p>
		</description>
		<setters>
			<set name="short">Strength, Dexterity, Wisdom, Alert Feat, Survival and Animal Handling Skills, Herbalism Kit</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_STR_DEX_WIS" />
			<grant type="Feat" id="ID_WOTC_PHB24_FEAT_ALERT" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_SURVIVAL" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_ANIMALHANDLING" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<grant type="Proficiency" id="ID_PROFICIENCY_TOOL_PROFICIENCY_HERBALISM_KIT" />
		</rules>
	</element>
</elements>
