<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Pilgrim</name>
		<description>Pilgrim background — broad/anywhere, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-pilgrim.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-pilgrim.xml" />
		</update>
	</info>
	<element name="Pilgrim" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_PILGRIM">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Strength, Constitution, Wisdom</li>
				<li><strong>Feat:</strong> Healer</li>
				<li><strong>Skill Proficiencies:</strong> Religion and Survival</li>
				<li><strong>Tool Proficiency:</strong> Herbalism Kit</li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Healer's Kit, Holy Symbol, Bedroll, Traveler's Clothes, Rations (5 days), 10 GP; or (B) 50 GP</li>
			</ul>
			<p>You spent your formative years traveling between sacred sites, shrines, and pilgrimage routes, learning the stories and traditions surrounding the silent gods.</p>
		</description>
		<setters>
			<set name="short">Strength, Constitution, Wisdom, Healer Feat, Religion and Survival Skills, Herbalism Kit</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_STR_CON_WIS" />
			<grant type="Feat" id="ID_WOTC_PHB24_FEAT_HEALER" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_RELIGION" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_SURVIVAL" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<grant type="Proficiency" id="ID_PROFICIENCY_TOOL_PROFICIENCY_HERBALISM_KIT" />
		</rules>
	</element>
</elements>
