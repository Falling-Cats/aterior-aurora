<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Monster Hunter</name>
		<description>Monster Hunter background — broad/anywhere, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-monster-hunter.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-monster-hunter.xml" />
		</update>
	</info>
	<element name="Monster Hunter" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_MONSTER_HUNTER">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Strength, Dexterity, Constitution</li>
				<li><strong>Feat:</strong> Savage Attacker</li>
				<li><strong>Skill Proficiencies:</strong> Survival and Nature</li>
				<li><strong>Tool Proficiency:</strong> Leatherworker's Tools</li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Shortbow, Arrows (20), Traveler's Clothes, Rations (5 days), 10 GP; or (B) 50 GP</li>
			</ul>
			<p>Raised in the North's contract-and-reputation hunting culture, you learned to track and take down dangerous beasts — practical, hard-won expertise passed down through experience, not schooling.</p>
		</description>
		<setters>
			<set name="short">Strength, Dexterity, Constitution, Savage Attacker Feat, Survival and Nature Skills, Leatherworker's Tools</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_STR_DEX_CON" />
			<grant type="Feat" id="ID_WOTC_PHB24_FEAT_SAVAGE_ATTACKER" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_SURVIVAL" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_NATURE" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<grant type="Proficiency" id="ID_PROFICIENCY_TOOL_PROFICIENCY_LEATHERWORKERS_TOOLS" />
		</rules>
	</element>
</elements>
