<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Caravaneer</name>
		<description>Caravaneer background — broad/anywhere, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-caravaneer.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-caravaneer.xml" />
		</update>
	</info>
	<element name="Caravaneer" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_CARAVANEER">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Dexterity, Wisdom, Charisma</li>
				<li><strong>Feat:</strong> Mobile</li>
				<li><strong>Skill Proficiencies:</strong> Persuasion and Survival</li>
				<li><strong>Tool Proficiency:</strong> <i>Choose one kind of Tool</i></li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Traveler's Clothes, Bedroll, Pouch, Gaming Set, Rations (5 days), 15 GP; or (B) 50 GP</li>
			</ul>
			<p>You grew up among nomadic traders, moving between kingdoms with a caravan family rather than a fixed home. You know a dozen roads, a dozen customs, and how to read a stranger fast.</p>
		</description>
		<setters>
			<set name="short">Dexterity, Wisdom, Charisma, Mobile Feat, Persuasion and Survival Skills, a Tool of your choice</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_DEX_WIS_CHA" />
			<grant type="Feat" id="ID_PHB_FEAT_MOBILE" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_PERSUASION" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_SURVIVAL" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<select type="Proficiency" name="Tool Proficiency (Caravaneer)" supports="Tool" />
		</rules>
	</element>
</elements>
