<elements>
	<info>
		<name>Exiled</name>
		<description>Exiled background — broad/anywhere, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-exiled.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-exiled.xml" />
		</update>
	</info>
	<element name="Exiled" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_EXILED">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Strength, Constitution, Intelligence</li>
				<li><strong>Feat:</strong> Mobile</li>
				<li><strong>Skill Proficiencies:</strong> Survival and Persuasion</li>
				<li><strong>Tool Proficiency:</strong> Herbalism Kit</li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Traveler's Clothes, Bedroll, Waterskin, Rations (5 days), 20 GP; or (B) 50 GP</li>
			</ul>
			<p>You were formally cast out of your settlement, kingdom, or community — fairly or not. You carry the reputation, real or assumed, and the habits of someone who's had to build a life with the door closed behind them.</p>
		</description>
		<setters>
			<set name="short">Strength, Constitution, Intelligence, Mobile Feat, Survival and Persuasion Skills, Herbalism Kit</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_STR_CON_INT" />
			<grant type="Feat" id="ID_PHB_FEAT_MOBILE" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_SURVIVAL" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_PERSUASION" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<grant type="Proficiency" id="ID_PROFICIENCY_TOOL_PROFICIENCY_HERBALISM_KIT" />
		</rules>
	</element>
</elements>
