<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Bloodkept</name>
		<description>Bloodkept background — broad/anywhere, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-bloodkept.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-bloodkept.xml" />
		</update>
	</info>
	<element name="Bloodkept" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_BLOODKEPT">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Constitution, Intelligence, Charisma</li>
				<li><strong>Feat:</strong> Survivor</li>
				<li><strong>Skill Proficiencies:</strong> Insight and Survival</li>
				<li><strong>Tool Proficiency:</strong> Herbalism Kit</li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Traveler's Clothes, Waterskin, Bedroll, Vial, 20 GP; or (B) 50 GP</li>
			</ul>
			<p>You were held, fed on, or otherwise kept by a vampire — not necessarily willingly, and not necessarily briefly. You survived it, but something about that time still shapes how you move through the world.</p>
		</description>
		<setters>
			<set name="short">Constitution, Intelligence, Charisma, Survivor Feat, Insight and Survival Skills, Herbalism Kit</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_CON_INT_CHA" />
			<grant type="Feat" id="ID_ATERIOR_FEAT_SURVIVOR" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_INSIGHT" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_SURVIVAL" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<grant type="Proficiency" id="ID_PROFICIENCY_TOOL_PROFICIENCY_HERBALISM_KIT" />
		</rules>
	</element>
</elements>
