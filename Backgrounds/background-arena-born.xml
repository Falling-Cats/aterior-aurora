	<element name="Arena-Born" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_ARENA_BORN">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Strength, Dexterity, Constitution</li>
				<li><strong>Feat:</strong> Tavern Brawler</li>
				<li><strong>Skill Proficiencies:</strong> Athletics and Intimidation</li>
				<li><strong>Tool Proficiency:</strong> Leatherworker's Tools</li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Handaxe, Padded Armor, Traveler's Clothes, Pouch, 20 GP; or (B) 50 GP</li>
			</ul>
			<p>You grew up in a culture of sanctioned combat, tournaments, and arena trials. You learned that reputation is earned by what you can actually accomplish.</p>
		</description>
		<setters>
			<set name="short">Strength, Dexterity, Constitution, Tavern Brawler Feat, Athletics and Intimidation Skills, Leatherworker's Tools</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_STR_DEX_CON" />
			<grant type="Feat" id="ID_WOTC_PHB24_FEAT_TAVERN_BRAWLER" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_ATHLETICS" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_INTIMIDATION" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<grant type="Proficiency" id="ID_PROFICIENCY_TOOL_PROFICIENCY_LEATHERWORKERS_TOOLS" />
		</rules>
	</element>
