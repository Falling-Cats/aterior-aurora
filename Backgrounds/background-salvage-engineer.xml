<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Salvage-Engineer</name>
		<description>Salvage-Engineer background — broad/anywhere, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-salvage-engineer.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-salvage-engineer.xml" />
		</update>
	</info>
	<element name="Salvage-Engineer" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_SALVAGE_ENGINEER">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Dexterity, Constitution, Intelligence</li>
				<li><strong>Feat:</strong> Craftsmanship</li>
				<li><strong>Skill Proficiencies:</strong> Investigation and Arcana</li>
				<li><strong>Tool Proficiency:</strong> Tinker's Tools</li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Tinker's Tools, Crowbar, Hooded Lantern, Oil (3 flasks), Traveler's Clothes, 5 GP; or (B) 50 GP</li>
			</ul>
			<p>You grew up in the wilderness near a dungeon still haunted by active constructs, or an artificer took you in and trained you. You learned to read, repair, and occasionally repurpose old, dangerous machinery.</p>
		</description>
		<setters>
			<set name="short">Dexterity, Constitution, Intelligence, Craftsmanship Feat, Investigation and Arcana Skills, Tinker's Tools</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_DEX_CON_INT" />
			<grant type="Feat" id="ID_ATERIOR_FEAT_CRAFTSMANSHIP" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_INVESTIGATION" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_ARCANA" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<grant type="Proficiency" id="ID_PROFICIENCY_TOOL_PROFICIENCY_TINKERS_TOOLS" />
		</rules>
	</element>
</elements>
