<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Frostbound</name>
		<description>Frostbound background — broad/anywhere, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-frostbound.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-frostbound.xml" />
		</update>
	</info>
	<element name="Frostbound" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_FROSTBOUND">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Strength, Constitution, Wisdom</li>
				<li><strong>Feat:</strong> Tough</li>
				<li><strong>Skill Proficiencies:</strong> Survival and Athletics</li>
				<li><strong>Tool Proficiency:</strong> Herbalism Kit</li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Bedroll, Winter Blanket, Traveler's Clothes, Waterskin, Rations (5 days), 10 GP; or (B) 50 GP</li>
			</ul>
			<p>Shaped by the North's brutal wilderness — cold, isolation, and the knowledge that help is far away and may not come. You learned to endure long before you learned to fight.</p>
		</description>
		<setters>
			<set name="short">Strength, Constitution, Wisdom, Tough Feat, Survival and Athletics Skills, Herbalism Kit</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_STR_CON_WIS" />
			<grant type="Feat" id="ID_WOTC_PHB24_FEAT_TOUGH" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_SURVIVAL" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_ATHLETICS" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<grant type="Proficiency" id="ID_PROFICIENCY_TOOL_PROFICIENCY_HERBALISM_KIT" />
		</rules>
	</element>
</elements>
