<elements>
	<info>
		<name>Ascendant</name>
		<description>Ascendant background — Aureole, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-ascendant.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-ascendant.xml" />
		</update>
	</info>
	<element name="Ascendant" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_ASCENDANT">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Strength, Constitution, Wisdom</li>
				<li><strong>Feat:</strong> Magic Initiate (Cleric)</li>
				<li><strong>Skill Proficiencies:</strong> Athletics and Religion</li>
				<li><strong>Tool Proficiency:</strong> Herbalism Kit</li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Climber's Kit, Traveler's Clothes, Rope (50 ft), Rations (5 days), 15 GP; or (B) 50 GP</li>
			</ul>
			<p>You grew up climbing Aureole's Nine Layers, undergoing the physical and spiritual trials required to reach the higher city. Something answered along the way — you're not sure what, only that you came down changed.</p>
		</description>
		<setters>
			<set name="short">Strength, Constitution, Wisdom, Magic Initiate (Cleric) Feat, Athletics and Religion Skills, Herbalism Kit</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_STR_CON_WIS" />
			<grant type="Feat" id="ID_WOTC_PHB24_FEAT_MAGIC_INITIATE_CLERIC" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_ATHLETICS" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_RELIGION" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<grant type="Proficiency" id="ID_PROFICIENCY_TOOL_PROFICIENCY_HERBALISM_KIT" />
		</rules>
	</element>
</elements>
