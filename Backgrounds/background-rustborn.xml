<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Rustborn</name>
		<description>Rustborn background — Aêtre, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-rustborn.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-rustborn.xml" />
		</update>
	</info>
	<element name="Rustborn" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_RUSTBORN">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Strength, Constitution, Intelligence</li>
				<li><strong>Feat:</strong> Survivor</li>
				<li><strong>Skill Proficiencies:</strong> Survival and Investigation</li>
				<li><strong>Tool Proficiency:</strong> Tinker's Tools</li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Tinker's Tools, Crowbar, Hooded Lantern, Oil (3 flasks), Traveler's Clothes, 5 GP; or (B) 50 GP</li>
			</ul>
			<p>You were born and raised in the wastes of fallen Aêtre itself, among the ruins and the constructs that still patrol them. Survival was never guaranteed, and you know it better than most.</p>
		</description>
		<setters>
			<set name="short">Strength, Constitution, Intelligence, Survivor Feat, Survival and Investigation Skills, Tinker's Tools</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_STR_CON_INT" />
			<grant type="Feat" id="ID_ATERIOR_FEAT_SURVIVOR" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_SURVIVAL" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_INVESTIGATION" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<grant type="Proficiency" id="ID_PROFICIENCY_TOOL_PROFICIENCY_TINKERS_TOOLS" />
		</rules>
	</element>
</elements>
