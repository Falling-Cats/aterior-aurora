<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Refugee</name>
		<description>Refugee background — broad/anywhere, ATÉRIOR.</description>
		<author>Falling-Cats</author>
		<update version="0.0.1">
			<file name="background-refugee.xml" url="https://raw.githubusercontent.com/Falling-Cats/aterior-aurora/main/Backgrounds/background-refugee.xml" />
		</update>
	</info>
	<element name="Refugee" type="Background" source="ATÉRIOR" id="ID_ATERIOR_BACKGROUND_REFUGEE">
		<description>
			<ul class="unstyled" style="text-indent:-1em; margin-left:1em; margin-bottom:5px">
				<li><strong>Ability Scores:</strong> Strength, Constitution, Wisdom</li>
				<li><strong>Feat:</strong> Musician</li>
				<li><strong>Skill Proficiencies:</strong> Survival and Insight</li>
				<li><strong>Tool Proficiency:</strong> Herbalism Kit</li>
				<li><strong>Equipment:</strong><i> Choose A or B:</i> (A) Traveler's Clothes, Bedroll, Waterskin, Pouch, Rations (5 days), 15 GP; or (B) 50 GP</li>
			</ul>
			<p>Conflict, disaster, or catastrophe forced you and your people from home while you were still a child. You grew up rebuilding a life in a place that wasn't yours, carrying a homeland that might not exist anymore.</p>
		</description>
		<setters>
			<set name="short">Strength, Constitution, Wisdom, Musician Feat, Survival and Insight Skills, Herbalism Kit</set>
		</setters>
		<rules>
			<grant type="Ability Score Improvement" id="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_COMBINATION_STR_CON_WIS" />
			<grant type="Feat" id="ID_WOTC_PHB24_FEAT_MUSICIAN" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_SURVIVAL" />
			<grant type="Proficiency" id="ID_PROFICIENCY_SKILL_INSIGHT" />
			<grant type="Grants" id="ID_INTERNAL_GRANTS_BACKGROUND_ASI" />
			<grant type="Proficiency" id="ID_PROFICIENCY_TOOL_PROFICIENCY_HERBALISM_KIT" />
		</rules>
	</element>
</elements>
